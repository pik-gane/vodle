# vodle — nginx configuration of the web container WITH TLS (docker-compose.tls.yml)
#
# The nginx image renders this template at container start, substituting
# only the TLS_* variables (NGINX_ENVSUBST_FILTER); everything else is nginx's
# own syntax. Keep the location blocks in step with nginx.conf, the plain
# HTTP configuration built into the image.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# plain HTTP: certbot's webroot challenges, everything else to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/${TLS_CERT};
    ssl_certificate_key /etc/nginx/tls/${TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:vodle:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 4m;

    # ---------- SPA routing ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- Matrix API reverse proxy ----------
    # The app talks to Matrix on its own origin; federation partners reach
    # the homeserver here too (.well-known/matrix/server names port 443).
    location /_matrix/ {
        proxy_pass http://synapse:8008;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # the sync long-poll (30 s) plus a margin
        proxy_read_timeout 120s;
    }

    # ---------- Matrix well-known (client and server discovery) ----------
    location /.well-known/matrix/ {
        proxy_pass http://synapse:8008;
        proxy_set_header Host $host;
    }

    # ---------- the privacy statement and the imprint (deploy/site) ----------
    location /site/ {
        alias /usr/share/nginx/html/site/;
    }

    # ---------- Static asset caching ----------
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1000;
}
