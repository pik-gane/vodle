# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
*.log
*.tmp
*.tmp.*
log.txt
*.sublime-project
*.sublime-workspace
.vscode/
npm-debug.log*

.angular/
.idea/
.ionic/
.sourcemaps/
.sass-cache/
.tmp/
.versions/
.gradle/
.idea/
coverage/
node_modules/
tmp/
temp/
www/
platforms/
plugins/
plugins/android.json
plugins/ios.json
$RECYCLE.BIN/

.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate

secret*
nohup.out

# Matrix homeserver data (local development and deployments: keys, config)
matrix-data/
# a deployment's database, secrets, site files and backups (deploy/README.md)
postgres-data/
.env
deploy/site/
deploy/acme/
deploy/backups/

# Guard bot dependencies
guard-bot/node_modules/

# Build output directory (Angular build artifacts)
docs/
node_modules/

# machine-readable karma summary (see karma.conf.js / scripts/check-test-results.js)
karma-results.json

# screenshots saved by the e2e smoke suite on failure (see test/wdio.conf.js)
e2e-screenshots/
