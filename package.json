    "test:couchdb:stop": "scripts/test-couchdb.sh stop",
    "test:couchdb": "scripts/test-couchdb.sh start && ng test --browsers=ChromeHeadlessNoSandbox --watch=false --include=**/data-service-couchdb-two-client.spec.ts",
